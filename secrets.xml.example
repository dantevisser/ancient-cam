<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to secrets.xml (gitignored) and set your camera's RTSP URL.
     Tapo: enable Camera Account (camera -> Advanced Settings -> Camera Account), then
       rtsp://USER:PASS@CAMERA_IP:554/stream1   (HD)   or   /stream2 (SD)
     Percent-encode any '@' in USER/PASS as %40. Keep formatted="false". -->
<resources>
    <string name="rtsp_url" formatted="false">rtsp://user:pass@192.168.0.100:554/stream1</string>
</resources>
