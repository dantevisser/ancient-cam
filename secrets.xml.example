<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to app/src/main/res/values/secrets.xml (gitignored) and set your camera's RTSP URL.
     Tapo: enable Camera Account (camera -> Advanced Settings -> Camera Account).
     IMPORTANT: the username and password must contain NO '@' character. Android 5.0's URL
     parser mis-splits rtsp://user@x:pass@host, so an email-style username breaks it.
     Use the low-res sub-stream (/stream2) on old chips: the MT8127 decoder cannot init 2K
     (/stream1) and fails with ERROR_CODE_DECODER_INIT_FAILED. -->
<resources>
    <string name="rtsp_url" formatted="false">rtsp://USER:PASS@CAMERA_IP:554/stream2</string>
</resources>
